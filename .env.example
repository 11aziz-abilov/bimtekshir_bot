# Telegram Bot token (@BotFather orqali olinadi)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Bot adminining Telegram user ID raqami (@userinfobot orqali bilish mumkin)
ADMIN_ID=123456789

# Ma'lumotlar bazasi fayl manzili (ixtiyoriy, standart: tests.db)
# DB_PATH=tests.db

# Majburiy kanal a'zoligi (subscription check) sozlamalari:
# Bot ushbu kanalda ADMINISTRATOR bo'lishi shart!
# Kanal ID raqami (masalan: -1001234567890 yoki @kanal_username)
CHANNEL_ID=@kanal_username

# Kanal username (@ bilan yoki havolasi)
CHANNEL_USERNAME=@kanal_username

# Kanal havolasi (ixtiyoriy, agar yopiq kanal bo'lsa taklif havolasi)
# CHANNEL_URL=https://t.me/+AbCdEfGhIjK

